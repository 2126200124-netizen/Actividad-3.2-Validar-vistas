<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:controller="edu.utj.dsm.poo.escuela.controlador.HorarioController" prefHeight="426" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="tabla" layoutX="20.0" layoutY="20" prefHeight="200.0" prefWidth="560.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
          <TableColumn fx:id="colDia" prefWidth="180.0" text="Día de la Semana" />
          <TableColumn fx:id="colInicio" prefWidth="140.0" text="Hora Inicio" />
          <TableColumn fx:id="colFin" prefWidth="140.0" text="Hora Fin" />
        </columns>
      </TableView>
      <Label layoutX="30.0" layoutY="240" text="ID Horario:" />
      <TextField fx:id="txtId" layoutX="30.0" layoutY="260" prefWidth="80.0" />
      <Label layoutX="130.0" layoutY="240" text="Día de la Semana:" />
      <ComboBox fx:id="cmbDia" layoutX="130.0" layoutY="260" prefWidth="150.0" promptText="Seleccionar" />
      <Label layoutX="300.0" layoutY="240" text="Hora Inicio:" />
      <TextField fx:id="txtInicio" layoutX="300.0" layoutY="260" prefWidth="110.0" promptText="Ej. 08:00" />
      <Label layoutX="430.0" layoutY="240" text="Hora Fin:" />
      <TextField fx:id="txtFin" layoutX="430.0" layoutY="260" prefWidth="110.0" promptText="Ej. 10:00" />
      <Button onAction="#onGuardar" fx:id="btnGuardar" layoutX="120.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Guardar" />
      <Button onAction="#onEditar" fx:id="btnEditar" layoutX="210.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Editar" />
      <Button onAction="#onEliminar" fx:id="btnEliminar" layoutX="300.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Borrar" />
      <Button onAction="#onLimpiar" fx:id="btnLimpiar" layoutX="390.0" layoutY="344" mnemonicParsing="false" text="Limpiar" />
      <Label fx:id="lblErrorId" alignment="TOP_LEFT" layoutX="30" layoutY="286" prefHeight="24.0" prefWidth="80" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorDia" alignment="TOP_LEFT" layoutX="130" layoutY="286" prefHeight="24.0" prefWidth="150" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorInicio" alignment="TOP_LEFT" layoutX="300" layoutY="286" prefHeight="24.0" prefWidth="110" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorFin" alignment="TOP_LEFT" layoutX="430" layoutY="286" prefHeight="24.0" prefWidth="110" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Button fx:id="btnNuevo" layoutX="20.0" layoutY="381" mnemonicParsing="false" onAction="#onNuevo" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="100.0" layoutY="381" mnemonicParsing="false" onAction="#onValidar" text="Validar" />
   </children>
</AnchorPane>