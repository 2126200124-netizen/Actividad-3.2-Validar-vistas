<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:controller="edu.utj.dsm.poo.escuela.controlador.DepartamentoController" prefHeight="426" prefWidth="550.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="tabla" layoutX="20.0" layoutY="20" prefHeight="200.0" prefWidth="510.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="100.0" text="ID Depto" />
          <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre Departamento" />
          <TableColumn fx:id="colEdificio" prefWidth="150.0" text="Edificio" />
        </columns>
      </TableView>
      <Label layoutX="30.0" layoutY="240" text="ID Depto:" />
      <TextField fx:id="txtId" layoutX="30.0" layoutY="260" prefWidth="100.0" />
      <Label layoutX="150.0" layoutY="240" text="Nombre Departamento:" />
      <TextField fx:id="txtNombre" layoutX="150.0" layoutY="260" prefWidth="200.0" />
      <Label layoutX="370.0" layoutY="240" text="Edificio:" />
      <TextField fx:id="txtEdificio" layoutX="370.0" layoutY="260" prefWidth="150.0" />
      <Button onAction="#onGuardar" fx:id="btnGuardar" layoutX="100.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Guardar" />
      <Button onAction="#onEditar" fx:id="btnEditar" layoutX="190.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Editar" />
      <Button onAction="#onEliminar" fx:id="btnEliminar" layoutX="280.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Borrar" />
      <Button onAction="#onLimpiar" fx:id="btnLimpiar" layoutX="370.0" layoutY="344" mnemonicParsing="false" text="Limpiar Formulario" />
      <Label fx:id="lblErrorId" alignment="TOP_LEFT" layoutX="30" layoutY="286" prefHeight="24.0" prefWidth="100" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorNombre" alignment="TOP_LEFT" layoutX="150" layoutY="286" prefHeight="24.0" prefWidth="200" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorEdificio" alignment="TOP_LEFT" layoutX="370" layoutY="286" prefHeight="24.0" prefWidth="150" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Button fx:id="btnNuevo" layoutX="20.0" layoutY="381" mnemonicParsing="false" onAction="#onNuevo" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="100.0" layoutY="381" mnemonicParsing="false" onAction="#onValidar" text="Validar" />
   </children>
</AnchorPane>