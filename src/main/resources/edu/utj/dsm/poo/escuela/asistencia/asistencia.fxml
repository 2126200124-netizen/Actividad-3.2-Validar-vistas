<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:controller="edu.utj.dsm.poo.escuela.controlador.AsistenciaController" prefHeight="426" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="tabla" layoutX="20.0" layoutY="20" prefHeight="200.0" prefWidth="560.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
          <TableColumn fx:id="colMatricula" prefWidth="180.0" text="Matrícula Alumno" />
          <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
          <TableColumn fx:id="colPresente" prefWidth="130.0" text="¿Presente?" />
        </columns>
      </TableView>
      <Label layoutX="30.0" layoutY="240" text="ID Asistencia:" />
      <TextField fx:id="txtId" layoutX="30.0" layoutY="260" prefWidth="100.0" />
      <Label layoutX="150.0" layoutY="240" text="Matrícula Alumno:" />
      <TextField fx:id="txtMatricula" layoutX="150.0" layoutY="260" prefWidth="150.0" />
      <Label layoutX="320.0" layoutY="240" text="Fecha:" />
      <DatePicker fx:id="dpFecha" layoutX="320.0" layoutY="260" prefWidth="130.0" />
      <CheckBox fx:id="chkPresente" layoutX="470.0" layoutY="264" mnemonicParsing="false" text="Presente" />
      <Button onAction="#onGuardar" fx:id="btnGuardar" layoutX="120.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Guardar" />
      <Button onAction="#onEditar" fx:id="btnEditar" layoutX="210.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Editar" />
      <Button onAction="#onEliminar" fx:id="btnEliminar" layoutX="300.0" layoutY="344" mnemonicParsing="false" prefWidth="80.0" text="Borrar" />
      <Button onAction="#onLimpiar" fx:id="btnLimpiar" layoutX="390.0" layoutY="344" mnemonicParsing="false" text="Limpiar" />
      <Label fx:id="lblErrorId" alignment="TOP_LEFT" layoutX="30" layoutY="286" prefHeight="24.0" prefWidth="100" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorMatricula" alignment="TOP_LEFT" layoutX="150" layoutY="286" prefHeight="24.0" prefWidth="150" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorFecha" alignment="TOP_LEFT" layoutX="320" layoutY="286" prefHeight="24.0" prefWidth="130" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Button fx:id="btnNuevo" layoutX="20.0" layoutY="381" mnemonicParsing="false" onAction="#onNuevo" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="100.0" layoutY="381" mnemonicParsing="false" onAction="#onValidar" text="Validar" />
   </children>
</AnchorPane>