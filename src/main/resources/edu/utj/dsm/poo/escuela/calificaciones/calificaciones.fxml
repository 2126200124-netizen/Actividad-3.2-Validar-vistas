<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:controller="edu.utj.dsm.poo.escuela.controlador.CalificacionesController" prefHeight="511" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="tabla" layoutX="20.0" layoutY="20" prefHeight="250.0" prefWidth="610.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
          <TableColumn fx:id="colMatricula" prefWidth="150.0" text="Matrícula Alumno" />
          <TableColumn fx:id="colMateria" prefWidth="150.0" text="Materia" />
          <TableColumn fx:id="colPeriodo" prefWidth="120.0" text="Periodo" />
          <TableColumn fx:id="colValor" prefWidth="100.0" text="Calificación" />
        </columns>
      </TableView>
      <Label layoutX="30.0" layoutY="300" text="ID:" />
      <TextField fx:id="txtId" layoutX="30.0" layoutY="320" prefWidth="70.0" />
      <Label layoutX="120.0" layoutY="300" text="Matrícula:" />
      <TextField fx:id="txtMatricula" layoutX="120.0" layoutY="320" prefWidth="130.0" />
      <Label layoutX="270.0" layoutY="300" text="Materia:" />
      <TextField fx:id="txtMateria" layoutX="270.0" layoutY="320" prefWidth="150.0" />
      <Label layoutX="440.0" layoutY="300" text="Periodo:" />
      <TextField fx:id="txtPeriodo" layoutX="440.0" layoutY="320" prefWidth="100.0" />
      <Label layoutX="30.0" layoutY="384" text="Calificación (0-100):" />
      <TextField fx:id="txtValor" layoutX="30.0" layoutY="404" prefWidth="100.0" />
      <Button onAction="#onGuardar" fx:id="btnGuardar" layoutX="160.0" layoutY="404" mnemonicParsing="false" text="Guardar" />
      <Button onAction="#onEditar" fx:id="btnEditar" layoutX="250.0" layoutY="404" mnemonicParsing="false" text="Editar" />
      <Button onAction="#onEliminar" fx:id="btnEliminar" layoutX="340.0" layoutY="404" mnemonicParsing="false" text="Borrar" />
      <Button onAction="#onLimpiar" fx:id="btnLimpiar" layoutX="430.0" layoutY="404" mnemonicParsing="false" text="Limpiar Formulario" />
      <Label fx:id="lblErrorId" alignment="TOP_LEFT" layoutX="30" layoutY="346" prefHeight="24.0" prefWidth="70" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorMatricula" alignment="TOP_LEFT" layoutX="120" layoutY="346" prefHeight="24.0" prefWidth="130" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorMateria" alignment="TOP_LEFT" layoutX="270" layoutY="346" prefHeight="24.0" prefWidth="150" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorPeriodo" alignment="TOP_LEFT" layoutX="440" layoutY="346" prefHeight="24.0" prefWidth="100" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Label fx:id="lblErrorValor" alignment="TOP_LEFT" layoutX="30" layoutY="430" prefHeight="24.0" prefWidth="100" style="-fx-text-fill: #d32f2f; -fx-font-size: 9px;" wrapText="true" />
      <Button fx:id="btnNuevo" layoutX="20.0" layoutY="466" mnemonicParsing="false" onAction="#onNuevo" text="Nuevo" />
      <Button fx:id="btnValidar" layoutX="100.0" layoutY="466" mnemonicParsing="false" onAction="#onValidar" text="Validar" />
   </children>
</AnchorPane>